# Use a PostgreSQL connection with session affinity (direct or session pooling).
DATABASE_URL=postgresql://r2_manager:local-development-only@localhost:5433/r2_manager
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
HACKCLUB_CLIENT_ID=
HACKCLUB_CLIENT_SECRET=
CLOUDFLARE_ACCOUNT_ID=
# The only Cloudflare credential (server-side only). R2 S3 credentials are derived from it.
# Required permissions: Workers R2 Storage: Edit, Account Analytics: Read,
# Account API Tokens: Edit, and DNS: Read on the hackclub-assets.com zone.
CLOUDFLARE_API_TOKEN=

# Zone ID for hackclub-assets.com (custom domains).
R2_CUSTOM_DOMAIN_ZONE_ID=
